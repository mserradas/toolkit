font-family = "Geist Mono"
font-feature = calt
font-feature = liga
font-size = 14

background-opacity = 0.95
background-blur-radius = 20

window-padding-color = extend
window-step-resize = false
window-padding-balance = true

# Tmux owns tabs, splits and terminal-state restoration.
window-save-state = never
keybind = cmd+d=ignore
keybind = cmd+shift+d=ignore
keybind = cmd+t=ignore
keybind = cmd+shift+t=ignore

### Mac Alt Fix
macos-option-as-alt = right

keybind = alt+left=unbind
keybind = alt+right=unbind

# Miscellaneous
keybind = cmd+g=text:\x1bg

# Use it by writing 'vim' first and then the keybinding to open the file with vim
keybind = alt+s=write_screen_file:paste
keybind = shift+enter=text:\x1b\r

# Theme
theme = GitHub Dark

# Tmux
command = "$SHELL" -l -c 'if type -q tmux; exec tmux new-session -A -s work; else; echo "tmux no está instalado; iniciando el shell"; exec "$SHELL" -l; end'

# Machine-specific settings loaded after this shared configuration.
config-file = ?local
