font-family = "JetBrains Mono"
font-feature = calt
font-feature = liga
font-size = 14

background-opacity = 1
background-blur-radius = 0

window-padding-color = extend
window-step-resize = false
window-padding-balance = true

# Theme
theme = Material Ocean
background = #111522
foreground = #eeeeee

# herdr-radar font block
font-codepoint-map = U+E1A0-U+E1B6="Herdr Agent Icons Max"
font-codepoint-map = U+E1C0-U+E1C5="Herdr Agent Icons Max"

# Herdr
command = /bin/sh -c 'PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"; export PATH; exec herdr'

# Keep the macOS window buttons and hide only the title text.
macos-titlebar-style = transparent
title = " "
